<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <PublishAot>true</PublishAot>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>vellum</AssemblyName>
        <AssemblyVersion>0.1.0.0</AssemblyVersion>
        <FileVersion>0.1.0.0</FileVersion>
        <InformationalVersion>0.1-alpha</InformationalVersion>
        <RootNamespace>Vellum</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SDL3-CS" Version="3.4.18.1" />
        <PackageReference Include="SDL3-CS.Native" Version="3.4.2" />
        <PackageReference Include="SkiaSharp" Version="4.154.0" />
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.148.0" />
        <PackageReference Include="StbImageSharp" Version="2.30.15" />
    </ItemGroup>
</Project>